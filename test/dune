(test
  (name test)
  (modes exe)
  (modules (:standard \ test_doc_manifest))
  (libraries abella_lib alcotest unix))

(test
  (name test_doc_manifest)
  (modes exe)
  (modules test_doc_manifest)
  (libraries abella_doc_manifest alcotest))

(rule
  (target test.mk)
  (deps
    ../bin/abella_dep.exe
    gen_test_mk.sh
    (source_tree ../examples))
  (action (chdir %{project_root}
    (run bash test/gen_test_mk.sh))))

(rule
  (alias runtest)
  (deps
    test.mk
    ../bin/abella.exe
    ../examples/modules/run.sh
    (source_tree ../test/modules)
    (glob_files_rec ../examples/*.thm)
    (glob_files_rec ../examples/*.thmod)
    (glob_files_rec ../examples/*.sig)
    (glob_files_rec ../examples/*.mod))
  (action (chdir %{project_root}
    (progn
      (run bash examples/modules/run.sh bin/abella.exe)
      (run make -k -j -B -f test/test.mk all)))))
