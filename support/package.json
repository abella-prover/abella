{
  "name": "abella_doc_lib",
  "version": "2.1.0-dev",
  "description": "Support code for abella_doc (https://abella-prover.org)",
  "private": true,
  "scripts": {
    "check": "tsc -noEmit",
    "build": "esbuild ./ts/abella_doc.ts --color=false --bundle --minify --format=esm --outfile=dist/abella_doc.js",
    "web:js": "node -e \"fs.rmSync('../web/chunks',{recursive:true,force:true})\" && esbuild ./ts/web/main.ts --bundle --format=esm --minify --splitting --outdir=../web --entry-names=abella_web --chunk-names=chunks/[name]-[hash]",
    "web:js:dev": "node -e \"fs.rmSync('../web/chunks',{recursive:true,force:true})\" && esbuild ./ts/web/main.ts --bundle --format=esm --minify --splitting --outdir=../web --entry-names=abella_web --chunk-names=chunks/[name]-[hash] --define:__GITHUB_OAUTH_WORKER__='\"http://127.0.0.1:8787\"'",
    "web:worker": "esbuild ./ts/web/worker.ts --bundle --format=iife --minify --outfile=../web/abella_js/worker.js",
    "web:callback": "esbuild ./ts/web/github-callback.ts --bundle --format=iife --minify --outfile=../web/github_callback.js",
    "web:css": "esbuild css/web.css --minify --outfile=../web/abella_web.css",
    "web:build": "npm run web:js && npm run web:worker && npm run web:callback && npm run web:css",
    "web:build:dev": "npm run web:js:dev && npm run web:worker && npm run web:callback && npm run web:css",
    "web:size": "node ./scripts/check-web-size.mjs",
    "web:test": "esbuild ./ts/web/commands.test.ts ./ts/web/editor.test.ts ./ts/web/session.test.ts ./ts/web/output-log.test.ts ./ts/web/renames.test.ts ./ts/web/workspace-directory.test.ts ./ts/web/workspace.test.ts ./ts/web/workspace-github.test.ts ./ts/web/github-auth.test.ts ./ts/web/github-oauth.test.ts --bundle --platform=node --format=cjs --outdir=../web/.test --log-level=warning && node --test ../web/.test/*.test.js"
  },
  "keywords": [],
  "author": "Kaustuv Chaudhuri <kaustuv@chaudhuri.info>",
  "license": "GPL-3",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@octokit/rest": "22.0.1",
    "fflate": "0.8.3"
  }
}
