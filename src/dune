(rule
 (targets version.ml)
 (action
  (with-stdout-to version.ml
   (progn
    (echo "(* Generated by dune from dune-project; do not edit. *)\n")
    (echo "let version = \"%{version:abella}\";;\n")
    (echo "let self_digest = lazy (Digest.file Sys.executable_name);;\n")))))

(library
 (name abella_lib)
 (libraries unix re yojson base64 ppx_abella_lib)
 (wrapped true)
 (preprocess (pps ppx_abella)))

(ocamllex
 (modules lexer))

(menhir
 (modules parser)
 (infer true)
 (flags --explain))
