(rule
 (targets version.ml)
 (deps (source_tree .))
 (action
  (with-stdout-to version.ml
   (bash "digest=$(printf '%s\n' %{deps} | sort | xargs cat | (sha256sum 2>/dev/null || shasum -a 256) | cut -d' ' -f1); printf '(* Generated by dune from dune-project; do not edit. *)\nlet version = \"%{version:abella}\";;\nlet source_digest = \"%s\";;\n' \"$digest\""))))

(library
 (name abella_lib)
 (libraries unix re yojson base64 ppx_abella_lib)
 (wrapped true)
 (preprocess (pps ppx_abella)))

(ocamllex
 (modules lexer))

(menhir
 (modules parser)
 (infer true)
 (flags --explain))
