(test
  (name test)
  (modes exe)
  (modules (:standard \ test_doc_manifest))
  (libraries abella_lib alcotest unix)
  (action (run %{test} --compact)))

(test
  (name test_doc_manifest)
  (modes exe)
  (modules test_doc_manifest)
  (libraries abella_doc_manifest alcotest)
  (action (run %{test} --compact)))

(rule
  (target test.mk)
  (deps
    (source_tree ../examples))
  (action (chdir %{project_root}
    (run %{exe:../bin/abella_dep.exe} -r -c -q -a bin/abella.exe
      -o test/test.mk examples))))

(rule
  (target test_imm.mk)
  (deps
    (source_tree ../examples))
  (action (chdir %{project_root}
    (run %{exe:../bin/abella_dep.exe} -r -c -q --suffix "_imm.out"
      -a "bin/abella_imm.exe -a" -o test/test_imm.mk examples))))

(rule
  (alias runtest)
  (deps
    test.mk
    ../bin/abella.exe
    test_imm.mk
    ../bin/abella_imm.exe
    ../examples/modules/run.sh
    (source_tree ../test/modules)
    (glob_files_rec ../examples/*.thm)
    (glob_files_rec ../examples/*.thmod)
    (glob_files_rec ../examples/*.sig)
    (glob_files_rec ../examples/*.mod))
  (action (chdir %{project_root}
    (progn
      (run bash examples/modules/run.sh bin/abella.exe)
      (run make -k -j -B -f test/test.mk all)
      (run bash examples/modules/run.sh bin/abella_imm.exe)
      (run make -k -j -B -f test/test_imm.mk all)))))
