(test
  (name test)
  (modes exe)
  (libraries abella_lib alcotest unix))

(rule
  (target test.mk)
  (deps
    ../bin/abella_dep.exe
    (glob_files_rec ../examples/*.thm)
    (glob_files_rec ../examples/*.sig)
    (glob_files_rec ../examples/*.mod))
  (action (chdir %{project_root}
    (run bin/abella_dep.exe -a "bin/abella.exe" -o test/test.mk -r examples))))

(rule
  (alias runtest)
  (deps
    test.mk
    ../bin/abella.exe
    (glob_files_rec ../examples/*.thm)
    (glob_files_rec ../examples/*.sig)
    (glob_files_rec ../examples/*.mod))
  (action (chdir %{project_root}
    (run make -k -j -B -f test/test.mk all))))
